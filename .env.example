# Copy to .env and change POSTGRES_PASSWORD before use.
# Local host-side commands use localhost; inside Docker Compose the host is overridden to "postgres".

POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=dss150p
POSTGRES_USER=dss150p
POSTGRES_PASSWORD=change_me

# Airflow local dev
AIRFLOW_UID=50000